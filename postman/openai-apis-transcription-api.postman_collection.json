          "item": [
            {
              "name": "OpenAI APIs Create transcription",
              "id": "2cc3fc75-d431-4030-b375-974cdf7bc85b",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "multipart/form-data"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "description": "(Required) The audio file to transcribe (flac, mp3, mp4, mpeg, mpga, m4a, ogg, wav, or webm)",
                      "key": "file",
                      "type": "file",
                      "value": null
                    },
                    {
                      "description": "(Required) The model to use for transcription (whisper-1)",
                      "key": "model",
                      "value": "<string>",
                      "type": "text"
                    },
                    {
                      "description": "The language of the input audio in ISO-639-1 format",
                      "key": "language",
                      "value": "<string>",
                      "type": "text"
                    },
                    {
                      "description": "Optional text to guide the model's style or continue a previous segment",
                      "key": "prompt",
                      "value": "<string>",
                      "type": "text"
                    },
                    {
                      "description": "The format of the transcription output (This can only be one of json,text,srt,verbose_json,vtt)",
                      "key": "response_format",
                      "value": "json",
                      "type": "text"
                    },
                    {
                      "description": "Sampling temperature between 0 and 1",
                      "key": "temperature",
                      "value": "0",
                      "type": "text"
                    },
                    {
                      "description": "The timestamp granularities to populate",
                      "key": "timestamp_granularities",
                      "value": "word,word",
                      "type": "text"
                    }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/audio/transcriptions",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "audio",
                    "transcriptions"
                  ]
                },
                "description": "Transcribes audio into the input language as text using the Whisper model."
              },
